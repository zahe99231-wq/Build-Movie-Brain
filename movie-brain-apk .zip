name: Build APK

on:
  push:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.7'

      - name: Unzip project
        run: |
          mkdir -p app_src
          unzip -q movie-brain-apk.zip -d app_src
          if [ ! -f "app_src/settings.gradle" ] && [ ! -f "app_src/settings.gradle.kts" ]; then
            SG=$(find app_src -maxdepth 4 \( -name "settings.gradle" -o -name "settings.gradle.kts" \) | head -n 1)
            if [ -n "$SG" ]; then
              PROJ_DIR=$(dirname "$SG")
              cp -r "$PROJ_DIR"/. app_src/
            fi
          fi

      - name: Build debug APK
        working-directory: app_src
        run: gradle assembleDebug --no-daemon

      - uses: actions/upload-artifact@v4
        with:
          name: movie-brain-apk
          path: app_src/app/build/outputs/apk/debug/app-debug.apk
